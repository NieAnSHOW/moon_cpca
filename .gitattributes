# data/adcodes.mbt is a generated artifact whose identity is its sha256
# (recorded in the plan's A11 evidence and in the product's own header
# comment). Pin LF so a fresh checkout -- on machines with the global
# default core.autocrlf=true -- has the same bytes as the committed blob
# and as a regenerated file. Deliberately scoped to the generated artifact
# only; no repo-wide EOL rewrite.
data/adcodes.mbt text eol=lf

# The three generated/consumed artifacts below carry a byte-identity
# contract: data/adcodes.mbt's header records the sha256 of the CSV bytes,
# and regen.py step 7/8 require a clean worktree after regeneration.
# Without these rules a fresh clone on a machine with core.autocrlf=true
# checks the files out as CRLF, so the regenerated LF bytes look modified.
# Scope stays artifact-only; no repo-wide EOL rewrite.
chinese_province_city_area_mapper/cpca/resources/adcodes.csv text eol=lf
testdata/golden.jsonl text eol=lf
testdata/golden.mbt text eol=lf
